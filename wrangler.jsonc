{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-ping",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-24",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/health"]
  },
  "build": {
    "command": "npm run build:web",
    "watch_dir": ["./src/web", "./scripts"]
  },
  "minify": false,
  "observability": {
    "enabled": true
  }
}
